# Copy to .env and change the passwords. Never commit .env or any real-data env file.
# `make e2e` reads ENV_FILE (default .env); real runs pass an env file kept outside the repo.

# --- Target database ---------------------------------------------------------------------------
# The ONE variable that decides which database gcw, dbt and the dashboard use.
# gcw_dev holds synthetic data only; gcw_real is for the repo owner's own terminal.
GCW_DB_NAME=gcw_dev

# --- Compose project -----------------------------------------------------------------------------
# Unset here: the default is the `name:` in docker-compose.yml (gc-wrapped). Containers and volumes
# are named after the project, so a different value means a different Postgres volume and password.
# A real-data env file kept outside the repo sets COMPOSE_PROJECT_NAME=gc-wrapped-real; CI uses
# gc-wrapped-ci. Every make target passes --env-file "$(ENV_FILE)", so it takes effect.
# COMPOSE_PROJECT_NAME=

# --- Host ports (127.0.0.1 only). Give two stacks different ports so they can run side by side. ---
# POSTGRES_HOST_PORT falls back to POSTGRES_PORT, then 5432. Keep POSTGRES_PORT equal to it when you
# run gcw or dbt from the host; containers always use 5432 inside the compose network.
# POSTGRES_HOST_PORT=5432
# DASHBOARD_PORT=8501

# --- Postgres (docker compose db service) ------------------------------------------------------
POSTGRES_USER=gcw
POSTGRES_PASSWORD=change-me
# Host port published on 127.0.0.1 for the db container.
POSTGRES_PORT=5432
# Host gcw and dbt connect to when run outside Docker. Containers set this to "db" themselves.
POSTGRES_HOST=localhost

# Optional. If empty, gcw builds its connection string from the POSTGRES_* values and GCW_DB_NAME.
# If set, its database must equal GCW_DB_NAME or gcw refuses to start.
DATABASE_URL=

# --- Dashboard (read-only role) ----------------------------------------------------------------
# Password for gcw_reader, a role that can read the analytics marts and nothing else (no message
# text). Created from docker/postgres/init/02-reader-role.sh the first time the db volume is made.
GCW_READER_PASSWORD=change-me-too
# Optional, same rule as DATABASE_URL: built from GCW_DB_NAME + GCW_READER_PASSWORD when empty.
DASHBOARD_DATABASE_URL=

# --- Consent allowlist (deny by default) -------------------------------------------------------
# Comma-separated numeric thread IDs (the digits at the end of a thread folder name) that you have
# consent to ingest. Ingestion loads ONLY these threads and fails if this is empty or unset. There
# is no bypass switch. The IDs below are the synthetic threads from tests/synthetic/instagram.py;
# a real-data env file lists the consented chat's ID instead.
GCW_THREAD_ALLOWLIST=1784563920183746,293847561029384,48271936502817364
# Per-sender consent ledger (D69), the second gate: external processing only. A CSV with one row per
# (thread, sender display name) and consent yes/no/blank (blank means no). Required by
# `make consent-template` and `make consent-load`. This dev path is synthetic and gitignored
# (`make synth` writes it). A real-data env file points at a path under ~/gcw-private instead.
GCW_CONSENT_LEDGER=./tests/fixtures/synthetic_consent/senders.csv
# Real-data env files only: a directory OUTSIDE the repo where the host-side `make real-ingest`
# writes the full (private) pipeline log. Not passed to any container. Unused by the dev stack.
# GCW_LOG_DIR=

# --- Pipeline ----------------------------------------------------------------------------------
# Host folder holding one subfolder per export; mounted read-only into the Airflow container.
# Use an absolute path for real data. Relative paths resolve against the repo.
GCW_LANDING_HOST_DIR=./data/landing
# Time zone dbt uses to derive local dates and hours (the gcw_timezone var). Raw stays UTC.
CHAT_TIMEZONE=America/Los_Angeles
LOG_LEVEL=INFO
